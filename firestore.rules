rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             data.credits is int && data.credits >= 0 &&
             data.plan is string && data.plan.size() <= 50 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProject(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.prompt is string && data.prompt.size() <= 1000 &&
             data.engine is string && data.engine.size() <= 50 &&
             data.industry is string && data.industry.size() <= 50 &&
             data.style is string && data.style.size() <= 50 &&
             data.badge is string && data.badge.size() <= 50 &&
             data.variantsCount is int && data.variantsCount >= 1 && data.variantsCount <= 16 &&
             data.primaryColor is string && data.primaryColor.size() <= 20 &&
             data.accentColor is string && data.accentColor.size() <= 20 &&
             data.isPublic is bool &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Per-user profile collection
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'email', 'credits', 'plan', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'avatarUrl', 'credits', 'plan', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'credits', 'plan', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Projects collection for recent projects and community feed
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);

      allow create: if isSignedIn() &&
                       isValidId(projectId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'title', 'prompt', 'engine', 'industry', 'style', 'badge', 'variantsCount', 'primaryColor', 'accentColor', 'isPublic', 'likesCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'prompt', 'engine', 'industry', 'style', 'badge', 'variantsCount', 'primaryColor', 'accentColor', 'isPublic', 'likesCount', 'createdAt', 'updatedAt']) &&
                       isValidProject(incoming());

      allow update: if isSignedIn() &&
                       isValidId(projectId) &&
                       resource.data.userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidProject(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'prompt', 'engine', 'industry', 'style', 'badge', 'variantsCount', 'primaryColor', 'accentColor', 'isPublic', 'likesCount', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(projectId) &&
                       resource.data.userId == request.auth.uid;
    }
  }
}
